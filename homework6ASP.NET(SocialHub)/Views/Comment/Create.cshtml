@model lesson6_ASP.NET.Models.Comment

@{
    ViewData["Title"] = "Створити коментар";
    var currentUsername = Context.Request.Cookies["Username"] ?? "Гість";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <h2 class="fw-bold mb-4 text-center">
                    <i class="bi bi-chat-left-text text-primary"></i> Новий коментар
                </h2>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Приховуємо PostId, щоб зв'язати коментар із постом -->
                    <input type="hidden" asp-for="PostId" />

                    <!-- Автоматично підтягуємо та ховаємо поле автора з куки -->
                    <input type="hidden" asp-for="Author" value="@currentUsername" />

                    <div class="alert alert-light border mb-3 py-2">
                        <small class="text-muted">Автор коментаря: <strong class="text-dark">@currentUsername</strong></small>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Text" class="control-label fw-semibold mb-2">Текст коментаря</label>
                        <textarea asp-for="Text" class="form-control" rows="4" placeholder="Напишіть щось..." required></textarea>
                        <span asp-validation-for="Text" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-controller="Post" asp-action="Index" class="btn btn-outline-secondary px-4">Скасувати</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send"></i> Відправити
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>