@using lesson6_ASP.NET.Context
@inject AppDbContext DbContext

<!DOCTYPE html>
<html lang="uk" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialHub</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        /* Однаковий розмір для вертикальних розділювачів */
        .nav-divider {
            border-left: 1px solid var(--bs-secondary);
            height: 24px;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Post" asp-action="Index">
                    <i class="bi bi-chat-square-text-fill text-primary"></i> SocialHub
                </a>

                <button class="navbar-toggler" type="button">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Ліве меню -->
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item d-flex align-items-center">
                            <div class="nav-divider ms-2 me-3"></div>
                            <a class="nav-link text-light p-0" asp-controller="Post" asp-action="Index">Головна</a>
                        </li>
                    </ul>

                    <!-- Праве меню -->
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        <!-- Кнопка створення поста -->
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Post" asp-action="Create">
                                <i class="bi bi-plus-lg"></i> Новий пост
                            </a>
                        </li>

                        @{
                            var currentUsername = Context.Request.Cookies["Username"];
                            int userId = 0;

                            if (!string.IsNullOrEmpty(currentUsername))
                            {
                                var dbUser = DbContext.Users.FirstOrDefault(u => u.Username == currentUsername);
                                if (dbUser != null)
                                {
                                    userId = dbUser.Id;
                                }
                                else
                                {
                                    Context.Response.Cookies.Delete("Username");
                                    currentUsername = null;
                                }
                            }
                        }

                        <!-- Блок авторизації -->
                        @if (!string.IsNullOrEmpty(currentUsername))
                        {
                            <li class="nav-item d-flex align-items-center gap-3">
                                <div class="nav-divider me-1"></div>
                                <span class="text-light fw-semibold">
                                    <i class="bi bi-person-circle"></i> @currentUsername
                                </span>
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout" asp-route-id="@userId">
                                    <i class="bi bi-box-arrow-right"></i> Вийти
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-flex align-items-center gap-2">
                                <div class="nav-divider me-1"></div>
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                                    Увійти
                                </a>
                                <a class="btn btn-light btn-sm text-dark" asp-controller="Account" asp-action="Register">
                                    Реєстрація
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Контент -->
    <div class="container flex-shrink-0 pb-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Футер -->
    <footer class="footer border-top text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - SocialHub
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>