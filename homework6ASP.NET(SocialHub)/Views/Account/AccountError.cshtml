@{

    ViewData["Title"] = "Помилка";
    Layout = "_LogAndRegLayout"; 
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-5">
                <div class="text-danger display-4 mb-3">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
                <h3 class="fw-bold mb-3">Помилка автентифікації</h3>

                <div class="alert alert-danger mb-4">
                    @(TempData["Error"] ?? "Сталася невідома помилка.")
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4">Назад</a>
                </div>
            </div>
        </div>
    </div>
</div>