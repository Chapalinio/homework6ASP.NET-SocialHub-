@model lesson6_ASP.NET.Models.Post

@{
    ViewData["Title"] = Model.Title;
    var isAdmin = Context.Request.Cookies["Username"] == "admin";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Назад до стрічки
    </a>
</div>

<!-- Картка поста -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>
        <div class="d-flex align-items-center text-muted mb-4 small">
            <span class="me-3"><i class="bi bi-person-fill"></i> <strong>@Model.Author</strong></span>
            <span><i class="bi bi-calendar-event"></i> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
        </div>
        <hr />
        <p class="card-text fs-6 text-dark" style="white-space: pre-line;">@Model.Text</p>
    </div>
</div>

<!-- Секція коментарів -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-4"><i class="bi bi-chat-dots"></i> Коментарі (@(Model.Comments?.Count ?? 0))</h4>

        @if (Model.Comments == null || !Model.Comments.Any())
        {
            <p class="text-muted">Ще немає коментарів. Будьте першим!</p>
        }
        else
        {
            <div class="list-group list-group-flush mb-4">
                @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                {
                    <div class="list-group-item px-0 py-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold text-secondary"><i class="bi bi-person-circle"></i> @comment.Author</span>
                            <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>
                        <p class="mb-2 text-dark">@comment.Text</p>

                        <!-- Кнопка-посилання на окрему сторінку видалення коментаря -->
                        @if (isAdmin)
                        {
                            <div class="mt-2">
                                <a asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Видалити
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <hr />

        <!-- Кнопка додавання коментаря прямо на сторінці поста -->
        <div class="mt-4">
            <a asp-controller="Comment" asp-action="Create" asp-route-postId="@Model.Id" class="btn btn-primary">
                <i class="bi bi-chat-square-plus"></i> Додати коментар
            </a>
        </div>
    </div>
</div>