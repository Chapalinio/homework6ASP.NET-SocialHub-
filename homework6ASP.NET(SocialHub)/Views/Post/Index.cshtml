@model IEnumerable<lesson6_ASP.NET.Models.Post>

@{
    ViewData["Title"] = "Стрічка постів";
    var isAdmin = Context.Request.Cookies["Username"] == "admin";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h1 class="fw-bold text-dark"><i class="bi bi-newspaper"></i> Стрічка новин</h1>
        <p class="text-muted">Діліться своїми думками та читайте інших</p>
    </div>
    <div class="col-md-6">
        <!-- Пошук за автором (Query-параметр author) -->
        <form asp-controller="Post" asp-action="Index" method="get" class="input-group">
            <input type="text" name="author" class="form-control" placeholder="Пошук за автором..." value="@Context.Request.Query["author"]">
            <button class="btn btn-outline-primary" type="submit">
                <i class="bi bi-search"></i> Знайти
            </button>
            @if (!string.IsNullOrEmpty(Context.Request.Query["author"]))
            {
                <a asp-controller="Post" asp-action="Index" class="btn btn-outline-secondary" title="Скинути пошук">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm">
        <i class="bi bi-info-circle display-4"></i>
        <p class="mt-3 fs-5">Постів ще немає або нічого не знайдено за вашим запитом.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">Створити перший пост</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-12 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title fw-bold text-primary mb-0">@item.Title</h5>
                            <span class="text-muted small"><i class="bi bi-clock"></i> @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted small">
                            <i class="bi bi-person-circle"></i> @item.Author
                        </h6>
                        <p class="card-text text-secondary">
                            @(item.Text.Length > 200 ? item.Text.Substring(0, 200) + "..." : item.Text)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-chat-left-text"></i> Читати повністю & Коментарі
                                </a>
                                <!-- Нова кнопка Редагувати -->
                                @if(isAdmin){
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Редагувати
                                    </a>
                                }
                            </div>
                            @if (isAdmin)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Видалити
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}