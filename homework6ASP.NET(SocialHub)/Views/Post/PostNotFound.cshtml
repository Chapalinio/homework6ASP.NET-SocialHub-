@{
    ViewData["Title"] = "Пост не знайдено";
}

<div class="row justify-content-center text-center my-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 py-5 px-4">
            <div class="card-body">
                <div class="text-warning display-1 mb-3">
                    <i class="bi bi-file-earmark-x"></i>
                </div>
                <h1 class="fw-bold text-dark mb-3">Пост не знайдено</h1>
                <p class="text-muted mb-4 fs-6">
                    Можливо, його було видалено, або ви перейшли за неіснуючим посиланням.
                </p>
                <a asp-controller="Post" asp-action="Index" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-arrow-left"></i> Повернутися до стрічки
                </a>
            </div>
        </div>
    </div>
</div>